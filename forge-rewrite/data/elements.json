    "affinity-rules": {
      "kind": "rule",
      "does": "Affinity is permanent, gained one point per mote fused at the Forge (forge.json fuse). At most two elements, never opposites; the first element gained is primary and the second can never exceed it; 6 is the most in one element; the total is limited by the affinity cap (progression.json affinity-cap: 1 + boss cores claimed + race bonus).",
      "maxElements": 2,
      "maxPerElement": 6,
      "primary": "the first element gained (or the race or court element)",
      "src": "js/engine/forge-adapter.js:66-93; js/elements/cores.js:12-15",
      "immunities": "The rank 3 and rank 6 immunities live on these rows only; statuses.md S11 points here (ruled 2026-10-16 Q5)"
    },
    "motes": {
      "kind": "rule",
      "does": "Motes are the six element materials. Gained: the run plan places them on floors (world.md W4-W5), chests, broken props and kills (loot.json), puzzle and boss rewards, the merchant (100 essence each), Wobbles gifts, the crystal-resonance room. Spent at the Forge only: fuse 1, enchant 1, carve per recipe (sigils.json). Old Anvil rank 3 may hand spent motes back (faith.md, Second Heat).",
      "kinds": [
        "fire",
        "water",
        "air",
        "earth",
        "light",
        "shadow"
      ],
      "src": "js/engine/forge-adapter.js:23, :42, :82; js/faith/religion.js:99-105"
    },
    "spell-ground": {
      "kind": "rule",
      "does": "At rank 6 of Fire, Water, Earth or Light, that element's spells mark every tile they strike for 3 game turns: fire (not on water), icy ground (foes standing on it gain a Chill stack each game turn unless airborne), grasping roots (a foe that moves onto it is Rooted 1 unless airborne), holy ground (light; power = spell power). Every struck tile also hits props with the spell's type.",
      "turns": 3,
      "src": "js/elements/elements.js:65-76, :135-143; js/engine/actor-ai.js:218"
    },
