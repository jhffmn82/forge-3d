      "min": 1,
      "src": "js/combat/combat.js:62-67"
    },
    "range-rule": {
      "kind": "rule",
      "does": "Aim range: a spell (rangeRule spell) is range + the race range bonus (Elf +1) + 1 with a staff; a technique (rangeRule technique) is range + the race bonus; fixed is the number as written; explored reaches any explored tile.",
      "src": "js/combat/combat.js:84-89; js/engine/casting-adapter.js:255-266"
    },
    "bar-order": {
      "kind": "rule",
      "does": "The hero's ability list: the class's first ability (the Cleric's god invoke), then Charge (Fighter) or Shadowstep (Scoundrel) second, then each held element's spells by rank 2, 4, 5 in the order the elements were gained.",
      "grantRanks": [
        2,
        4,
        5
      ],
      "src": "js/engine/stats.js:62-73; js/elements/elements.js:10-17",
      "keepLayout": "New abilities go into the first empty slots; the player's arrangement stays (ruled 2026-10-16 Q28)"
